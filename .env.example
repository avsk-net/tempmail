# ─────────────────────────────────────────────────────────
#  .env.example  —  copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# The domain that will receive temporary emails
# MX record must point to this server's IP
MAIL_DOMAIN=tmpbox.io

# Inbox lifetime in seconds (default: 600 = 10 minutes)
INBOX_TTL_SECONDS=600

# Redis connection (change password in redis.conf too)
REDIS_URL=redis://redis:6379

# SMTP listen port inside the container (external is always 25)
SMTP_PORT=25

# Maximum inbound message size in bytes (5 MB)
MAX_MSG_BYTES=5242880

# API internal URL used by the SMTP service (Docker service name)
API_INTERNAL_URL=http://api:3000
